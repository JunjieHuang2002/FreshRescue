# FreshRescue development settings. Create your own copy with:  cp .env.example .env
# The development password below is public on purpose: this is a local demo. It has upper
# and lower case letters, a digit and a special character, so it also passes MySQL's default
# password policy (validate_password, MEDIUM).

# MySQL database used by the API (created by tools/sql/init-dev.sql).
DATABASE_URL=mysql://freshrescue:FreshRescue_dev_1@localhost:3306/freshrescue

# MySQL database used by `npm run test:db` and `npm run test:e2e`.
# The tests always use this one, never DATABASE_URL.
TEST_DATABASE_URL=mysql://freshrescue:FreshRescue_dev_1@localhost:3306/freshrescue_test

# Port of the API (apps/api). The web app listens on 3000 and forwards /api/* to the API.
API_PORT=4000

# Where the web app forwards /api/* to. Next.js reads this variable from the real
# environment when the app is built (it does not read this file), so export it in the
# shell if you change API_PORT. The default is http://localhost:4000.
# API_ORIGIN=http://localhost:4000
